{
  "version": "2.0.0",
  "tasks": [
    {
		"label": "npm:dev-main",
		"type": "shell",
		"command": "npm run dev",
		"isBackground": true,
		"options": {
			"cwd": "${workspaceFolder}/frontend/main"
		},
		"problemMatcher": [
			{
				"owner": "npm:dev-main",
				"pattern": [
					{
						"regexp": ".",
						"file": 1,
						"location": 2,
						"message": 3
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Local:"
				}
			}
		]
    },
    {
      "label": "stop-dev",
      "type": "shell",
      "command": "pkill -f vite",
      "options": {
        "cwd": "${workspaceFolder}/frontend/main"
      }
    },
	{
	  "label": "dotnet:build-api",
	  "type": "shell",
	  "command": "dotnet build",
	  "options": {
		"cwd": "${workspaceFolder}/backend"
	  }
	},
  ]
}