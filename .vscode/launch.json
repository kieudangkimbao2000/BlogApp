{
  "version": "0.2.0",
  "configurations": [    
    {
      "type": "chrome",
      "request": "launch",
      "name": "FrontEnd Main",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/main/src",
      "preLaunchTask": "npm:dev-main",
      "postDebugTask": "stop-dev"
    },
    {
      "type": "coreclr",
      "request": "launch",
      "name": "BackEnd API",
      "program": "${workspaceFolder}/backend/bin/Debug/net10.0/BlogApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "dotnet:build-api"
    },
  ]
}